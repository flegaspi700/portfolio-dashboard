# Copy this file to .env and fill in real values. .env is git-ignored;
# this file is committed so everyone can see which variables are needed.
# Never put real secrets in this file. See the standard's security.md -> Secrets.

# The read-only GitHub token the scan uses (fine-grained; Contents, Metadata
# and Pull requests: read). See docs/security.md -> T2. In the Action it comes
# from the repo secret of the same name.
PORTFOLIO_READ_TOKEN=
